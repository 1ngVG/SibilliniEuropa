{
  "name": "sibillini-europa-gallery-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:clean": "node src/scripts/clean-dist.js",
    "dev": "astro dev",
    "build:galleries": "node src/scripts/build-galleries.js",
    "build:partners-data": "node src/scripts/build-partners.js",
    "build:staff-data": "node src/scripts/build-staff.js",
    "build:committee-data": "node src/scripts/build-scientific-committee.js",
    "build:schedule": "node src/scripts/build-schedule.js",
    "sync:content": "node src/scripts/sync-content-from-drive.js && node src/scripts/sync-content-from-urls.js",
    "build:demo-page": "node src/scripts/build-demo-page.js",
    "build:gallery-widget": "vite build --config vite.widget.config.mjs",
    "build:widget": "npm run build:gallery-widget",
    "build:partners-widget": "vite build --config vite.partners.config.mjs",
    "build:staff-widget": "vite build --config vite.staff.config.mjs",
    "build:committee-widget": "vite build --config vite.committee.config.mjs",
    "build:schedule-widget": "vite build --config vite.schedule.config.mjs",
    "build:demo": "npm run build:demo-page && astro build",
    "build": "npm run sync:content && npm run build:clean && npm run build:galleries && npm run build:partners-data && npm run build:staff-data && npm run build:committee-data && npm run build:schedule && npm run build:demo-page && npm run build:gallery-widget && npm run build:partners-widget && npm run build:staff-widget && npm run build:committee-widget && npm run build:schedule-widget",
    "preview:gallery-widget": "vite preview --config vite.widget.config.mjs",
    "preview": "npm run preview:gallery-widget"
  },
  "dependencies": {
    "astro": "^7.2.7",
    "caveman-installer": "github:JuliusBrussee/caveman#v2.3.1",
    "fast-glob": "^3.3.3",
    "glightbox": "^3.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}

---
import { renderShowcaseLeadHtml, renderShowcaseWidgets, showcaseStyles, showcaseTitle } from "../demo/showcase.js";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{showcaseTitle}</title>
    <style is:inline>{showcaseStyles}</style>
    <script>
      window.GALLERY_WIDGET_BASE_URL = "/";
    </script>
    <script type="module">
      import "../gallery/widget.js";
      import "../partners/widget.js";
      import "../staff/widget.js";
      import "../schedule/schedule.js";
    </script>
  </head>
  <body>
    <main>
      <h1>{showcaseTitle}</h1>
      <p set:html={renderShowcaseLeadHtml()}></p>
      <div class="demo-columns" set:html={renderShowcaseWidgets()}></div>
    </main>
  </body>
</html>
